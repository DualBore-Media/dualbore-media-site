# Server-side Netlify Functions configuration only. Never use VITE_ prefixes.
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
# Optional internal notification destination. Leave empty to disable.
RESEND_NOTIFY_TO=

# Production switches remain server-only and OFF throughout pre-deployment.
COMMERCE_ENVIRONMENT=test
PAYMENTS_ENABLED=false
TRANSACTIONAL_EMAILS_ENABLED=false
# Managed auth: public key is intentionally public; secret is server-only.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_FRONTEND_ORIGIN=
LOW_STOCK_THRESHOLD=5
FULFILLMENT_REVIEW_HOURS=72
# Optional extra progress notifications; required confirmations stay separate.
CUSTOMER_PROGRESS_EMAILS=false

# LOCAL SANDBOX ONLY. Never set VITE_ secret variables. No publishable key needed.
COMMERCE_TEST_ENABLED=false
COMMERCE_MOCK=false
SITE_ORIGIN=http://127.0.0.1:4176
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DATABASE_URL=
STRIPE_AUTOMATIC_TAX=false
TEST_SHIPPING_RATE_CENTS=700
# Explicit demo seed quantity, never production inventory.
TEST_INVENTORY_PER_VARIANT=0
# Used only by the local mocked PostgreSQL-compatible engine.
TEST_DATABASE_DIRECTORY=.tools/commerce-test-db
# Future launch declarations. Empty and intentionally unapproved.
STORE_CURRENCY=usd
STORE_COUNTRY=US
BUSINESS_LEGAL_NAME=
BUSINESS_POSTAL_ADDRESS=
SUPPORT_EMAIL=
SHIPPING_RATE_CENTS=
SHIPPING_CONFIGURATION_APPROVED=false
POLICIES_APPROVED=false
LIVE_CATALOG_APPROVED=false
TAX_CONFIGURATION_APPROVED=false
RESEND_DOMAIN_VERIFIED=false
AUTH_PRODUCTION_VERIFIED=false
ADMIN_MFA_VERIFIED=false
PRODUCTION_DATABASE_VERIFIED=false
DATABASE_BACKUP_RESTORE_VERIFIED=false
STRIPE_WEBHOOK_VERIFIED=false
RESEND_DELIVERY_VERIFIED=false
PROCESSING_TIME_APPROVED=false
RETURN_WINDOW_APPROVED=false
RETENTION_POLICY_APPROVED=false
SUPPORT_WORKFLOW_APPROVED=false
LIVE_INVENTORY_APPROVED=false

SECURITY_REVIEW_PASSED=false
REQUIRED_TESTS_PASSED=false
MIGRATIONS_VERIFIED=false
MARKETING_SUPPRESSION_VERIFIED=false
FRONTEND_PRODUCTION_QA_VERIFIED=false
